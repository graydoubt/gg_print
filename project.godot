; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="gg.print() demo project"
config/description="gg.print() prints clickable messages to the output panel that link back to the source."
run/main_scene="res://demo/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

gg="*res://addons/gg_print/print.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/gg_print/plugin.cfg")

[rendering]

textures/vram_compression/import_etc2_astc=true
